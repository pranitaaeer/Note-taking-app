generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma""
}

datasource db {
  provider = "postgresql"
}

enum ShareType {
  ONE_TIME
  TIME_BASED
}

enum AccessType {
  PUBLIC
  PASSWORD
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notes Note[]

  @@index([email])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareLinks ShareLink[]

  @@index([userId])
}

model ShareLink {
  id            String     @id @default(cuid())
  noteId        String
  token         String     @unique
  shareType     ShareType
  accessType    AccessType
  accessKeyHash String?
  expiresAt     DateTime?
  usedAt        DateTime?
  revokedAt     DateTime?
  viewCount     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([token])
  @@index([expiresAt])
}
